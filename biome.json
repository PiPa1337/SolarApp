{
  "$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!placeholder-dump.json",
      "!.superpowers/sdd",
      "!packages/exporter/src/fonts.ts",
      "!**/.solara-runtime",
      "!**/dist",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.release",
      "!**/proyectos",
      "!**/screenshots",
      "!**/_qa",
      "!.local-backups",
      "!**/back up",
      "!**/back up/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "vcs": {
    "enabled": false
  }
}
