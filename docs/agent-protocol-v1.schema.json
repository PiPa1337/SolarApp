{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solara.local/schemas/agent-protocol-v1.schema.json",
  "title": "SolaraCommerce Agent Protocol v1",
  "description": "Contrato cerrado para que una IA opere tiendas sin parches arbitrarios.",
  "type": "object",
  "required": ["protocol", "version", "methods", "scopes"],
  "properties": {
    "protocol": { "const": "solara-agent" },
    "version": { "const": 1 },
    "methods": {
      "type": "array",
      "items": {
        "enum": [
          "health",
          "protocol.describe",
          "stores.list",
          "stores.get",
          "stores.restore",
          "templates.get",
          "templates.previewUpgrade",
          "templates.commitUpgrade",
          "rollouts.preview",
          "rollouts.commit",
          "rollouts.get",
          "rollouts.rollback",
          "plans.create",
          "plans.createAndCommit",
          "plans.get",
          "plans.commit",
          "plans.discard",
          "plans.heartbeat",
          "jobs.get",
          "audit.list",
          "assets.stage",
          "assets.generatePlaceholder",
          "assets.upload.begin",
          "assets.upload.chunk",
          "assets.upload.finish",
          "qa.runExport",
          "qa.runGates",
          "qa.detectFlaky",
          "qa.writeTest",
          "qa.readBacklog",
          "qa.logProgress",
          "qa.updateState",
          "qa.runCycle",
          "qa.status"
        ]
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "plans:write",
          "commit",
          "assets:write",
          "audit:read",
          "template:read",
          "template:write",
          "rollouts:read",
          "rollouts:write",
          "qa:write"
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$", "maxLength": 96 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "variantInput": {
      "type": "object",
      "required": ["title", "priceCents"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sku": { "type": "string", "maxLength": 120 },
        "priceCents": { "type": "integer", "minimum": 0 },
        "compareAtPriceCents": { "type": "integer", "minimum": 0 },
        "available": { "type": "boolean" },
        "stockStatus": { "enum": ["in_stock", "out_of_stock", "preorder"] },
        "optionValues": { "type": "object", "additionalProperties": { "type": "string" } },
        "imageId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "store.create" },
            "storeId": { "$ref": "#/$defs/id" },
            "name": { "type": "string", "minLength": 1 },
            "brandName": { "type": "string" },
            "slug": { "$ref": "#/$defs/slug" },
            "baseUrl": { "type": "string", "format": "uri" },
            "email": { "type": "string" },
            "phone": { "type": "string", "pattern": "^\\d{0,15}$" },
            "source": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["kind", "templateId"],
                  "properties": {
                    "kind": { "const": "base-template" },
                    "templateId": { "const": "catalog-modern" }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["kind"],
                  "properties": { "kind": { "const": "clean" } },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "changes"],
          "properties": {
            "type": { "const": "store.updateIdentity" },
            "changes": {
              "type": "object",
              "properties": {
                "slug": { "$ref": "#/$defs/slug" },
                "title": { "type": "string", "maxLength": 160 },
                "description": { "type": "string", "maxLength": 2000 },
                "status": { "enum": ["active", "hidden"] },
                "imageId": { "$ref": "#/$defs/id" }
              },
              "additionalProperties": false
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "changes"],
          "properties": {
            "type": { "const": "store.updateSeo" },
            "changes": { "type": "object", "additionalProperties": false }
          }
        },
        {
          "type": "object",
          "required": ["type", "changes"],
          "properties": {
            "type": { "const": "store.updatePublicCopy" },
            "changes": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["type", "changes"],
          "properties": {
            "type": { "const": "store.updatePolicies" },
            "changes": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["type", "changes"],
          "properties": {
            "type": { "const": "store.updateLegalProfile" },
            "changes": { "type": "object", "additionalProperties": false }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "store.updateWhatsapp" },
            "phone": { "type": "string", "pattern": "^\\d{0,15}$" },
            "greeting": { "type": "string" },
            "includeSku": {
              "type": "boolean",
              "deprecated": true,
              "description": "Campo legado aceptado por compatibilidad. No modifica el mensaje de WhatsApp."
            }
          },
          "anyOf": [
            { "required": ["phone"] },
            { "required": ["greeting"] },
            { "required": ["includeSku"] }
          ]
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "store.updateNavigation" },
            "mode": { "enum": ["automatic", "curated"] },
            "catalogLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
            "items": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": ["id", "label"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "label": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "href": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "anyOf": [
            { "required": ["mode"] },
            { "required": ["catalogLabel"] },
            { "required": ["items"] }
          ]
        },
        {
          "type": "object",
          "required": ["type", "slug", "title"],
          "properties": {
            "type": { "const": "category.create" },
            "categoryId": { "$ref": "#/$defs/id" },
            "slug": { "$ref": "#/$defs/slug" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "parentId": { "$ref": "#/$defs/id" },
            "imageId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "required": ["type", "categoryId", "changes"],
          "properties": {
            "type": { "const": "category.update" },
            "categoryId": { "$ref": "#/$defs/id" },
            "changes": { "type": "object", "additionalProperties": false }
          }
        },
        {
          "type": "object",
          "required": ["type", "categoryId", "status"],
          "properties": {
            "type": { "const": "category.setStatus" },
            "categoryId": { "$ref": "#/$defs/id" },
            "status": { "enum": ["active", "hidden"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "categoryId", "confirmation"],
          "properties": {
            "type": { "const": "category.delete" },
            "categoryId": { "$ref": "#/$defs/id" },
            "confirmation": { "const": "ELIMINAR_CATEGORIA" }
          }
        },
        {
          "type": "object",
          "required": ["type", "slug", "title"],
          "properties": {
            "type": { "const": "collection.create" },
            "collectionId": { "$ref": "#/$defs/id" },
            "slug": { "$ref": "#/$defs/slug" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "imageId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "required": ["type", "collectionId", "changes"],
          "properties": {
            "type": { "const": "collection.update" },
            "collectionId": { "$ref": "#/$defs/id" },
            "changes": {
              "type": "object",
              "properties": {
                "slug": { "$ref": "#/$defs/slug" },
                "title": { "type": "string", "maxLength": 160 },
                "description": { "type": "string", "maxLength": 2000 },
                "status": { "enum": ["active", "hidden"] },
                "imageId": { "$ref": "#/$defs/id" }
              },
              "additionalProperties": false
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "slug", "title"],
          "properties": {
            "type": { "const": "product.create" },
            "productId": { "$ref": "#/$defs/id" },
            "slug": { "$ref": "#/$defs/slug" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "priceCents": { "type": "integer", "minimum": 0 },
            "categoryIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "collectionIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "imageIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variantInput" } }
          }
        },
        {
          "type": "object",
          "required": ["type", "productId", "changes"],
          "properties": {
          "type": { "const": "product.update" },
          "productId": { "$ref": "#/$defs/id" },
            "changes": {
              "type": "object",
              "properties": {
                "slug": { "$ref": "#/$defs/slug" },
                "title": { "type": "string", "maxLength": 200 },
                "description": { "type": "string", "maxLength": 10000 },
                "brand": { "type": "string", "maxLength": 120 },
                "categoryIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
                "collectionIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
                "tags": { "type": "array", "items": { "type": "string" } },
                "imageIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
                "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variantInput" } },
                "priceCents": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "productIds", "adjustment"],
          "properties": {
            "type": { "const": "products.adjustPrices" },
            "productIds": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/id" } },
            "adjustment": {
              "oneOf": [
                { "type": "object", "required": ["type", "cents"], "properties": { "type": { "const": "amount" }, "cents": { "type": "integer" } }, "additionalProperties": false },
                { "type": "object", "required": ["type", "basisPoints"], "properties": { "type": { "const": "percentage" }, "basisPoints": { "type": "integer", "minimum": -10000, "maximum": 1000000 } }, "additionalProperties": false }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "productIds"],
          "properties": {
            "type": { "const": "products.reorder" },
            "productIds": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/id" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "productId", "status"],
          "properties": {
            "type": { "const": "product.setStatus" },
            "productId": { "$ref": "#/$defs/id" },
            "status": { "enum": ["active", "hidden", "archived"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "productId", "confirmation"],
          "properties": {
            "type": { "const": "product.delete" },
            "productId": { "$ref": "#/$defs/id" },
            "confirmation": { "const": "ELIMINAR_PRODUCTO" }
          }
        },
        {
          "type": "object",
          "required": ["type", "confirmation"],
          "properties": {
            "type": { "const": "store.archive" },
            "storeId": { "$ref": "#/$defs/id" },
            "confirmation": { "const": "ARCHIVAR_TIENDA" }
          }
        },
        {
          "type": "object",
          "required": ["type", "sectionId", "settings"],
          "properties": {
            "type": { "const": "section.updateSettings" },
            "sectionId": { "$ref": "#/$defs/id" },
            "settings": { "type": "object" }
          }
        },
        {
          "type": "object",
          "required": ["type", "assetId", "target"],
          "properties": {
            "type": { "const": "asset.attach" },
            "assetId": { "$ref": "#/$defs/id" },
            "target": { "enum": ["identity.logo", "seo.favicon", "seo.social", "product"] },
            "productId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "required": ["type", "assetId"],
          "properties": {
            "type": { "const": "asset.remove" },
            "assetId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "required": ["type", "categoryId", "skuPrefix", "basePriceCents", "items"],
          "properties": {
            "type": { "const": "product.createBatch" },
            "categoryId": { "$ref": "#/$defs/id" },
            "imageIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "tags": { "type": "array", "items": { "type": "string" } },
            "skuPrefix": { "type": "string", "minLength": 1 },
            "basePriceCents": { "type": "integer", "minimum": 0 },
            "priceStepCents": { "type": "integer", "minimum": 0 },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "presetId"],
          "properties": {
            "type": { "const": "theme.applyPreset" },
            "presetId": { "enum": ["editorial", "minimal", "calido", "industrial", "botanico", "pao-blanqueria"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "tokens"],
          "properties": {
            "type": { "const": "theme.updateTokens" },
            "tokens": { "type": "object" }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "required": ["id", "method"],
      "properties": {
        "protocol": { "const": "solara-agent" },
        "version": { "const": 1 },
        "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
        "method": { "type": "string" },
        "params": {}
      }
    },
    "planCreate": {
      "type": "object",
      "required": ["operations"],
      "properties": {
        "storeId": { "$ref": "#/$defs/id" },
        "baseVersion": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "idempotencyKey": { "type": "string", "minLength": 8 },
        "includeDiff": { "type": "boolean", "default": true },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "assetStage": {
      "type": "object",
      "required": ["name", "mimeType", "source"],
      "properties": {
        "name": { "type": "string" },
        "alt": { "type": "string" },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/avif", "image/gif", "image/x-icon"] },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "data"],
              "properties": {
                "kind": { "const": "base64" },
                "data": { "type": "string", "maxLength": 8000000 }
              }
            },
            {
              "type": "object",
              "required": ["kind", "filename"],
              "properties": { "kind": { "const": "inbox" }, "filename": { "type": "string" } }
            }
          ]
        }
      }
    }
  }
}
