{
  "name": "@solara/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --configLoader runner && node ../../scripts/dedup-studio-css.mjs",
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "test": "vitest run --configLoader runner --pool=threads --maxWorkers=8 --minWorkers=8 --exclude src/lib/fuzz-navigation.test.ts",
    "test:ci": "vitest run --configLoader runner --pool=threads --maxWorkers=2 --minWorkers=2 --exclude src/lib/fuzz-navigation.test.ts",
    "test:fuzz": "vitest run --configLoader runner --no-file-parallelism src/lib/fuzz-navigation.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@solara/core": "workspace:*",
    "@solara/exporter": "workspace:*",
    "@solara/modules": "workspace:*",
    "@solara/project-schema": "workspace:*",
    "@solara/storefront-runtime": "workspace:*",
    "@tanstack/react-table": "8.21.3",
    "dexie": "4.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "fake-indexeddb": "6.2.5",
    "vite": "7.1.3"
  }
}
