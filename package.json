{
  "name": "solara-commerce",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "audit:performance:rm": "node scripts/rm-performance-audit.mjs",
    "audit:performance:rm:readonly": "vitest run scripts/rm-performance-readonly.test.ts --testTimeout=120000 --exclude \"back up/**\" --exclude \".local-backups/**\"",
    "audit:performance:rm:node": "vitest run scripts/rm-performance-node.test.ts --testTimeout=1800000 --no-file-parallelism --pool=threads --poolOptions.threads.singleThread --exclude \"back up/**\" --exclude \".local-backups/**\"",
    "audit:performance:rm:browser": "node scripts/rm-performance-browser.mjs",
    "audit:performance:rm:merge": "node scripts/rm-performance-merge.mjs",
    "build": "corepack pnpm --filter @solara/studio build",
    "build:tray": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-tray.ps1",
    "test:tray": "corepack pnpm build:tray && node scripts/tray-smoke.mjs",
    "check:budgets": "node scripts/check-budgets.mjs && vitest run scripts/storefront-runtime-budget.test.ts scripts/public-storefront-budget.test.ts --exclude \"back up/**\" --exclude \".local-backups/**\"",
    "check:image-budget": "node scripts/check-image-budget.mjs",
    "check:optimization": "vitest run scripts/site-optimizer-check.test.ts scripts/optimization-baseline.test.ts --exclude \"back up/**\" --exclude \".local-backups/**\"",
    "check:responsive": "node scripts/check-responsive-contract.mjs",
    "check:runtime-serialization": "vitest run scripts/runtime-serialization.test.ts --exclude \"back up/**\" --exclude \".local-backups/**\"",
    "check": "corepack pnpm check:fast",
    "check:full": "corepack pnpm check:fast && corepack pnpm test:extended && corepack pnpm check:slow && corepack pnpm build && corepack pnpm test:postbuild",
    "check:quick": "node scripts/check-quick.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:hardcoded-content": "node scripts/check-hardcoded-content.mjs",
    "dev": "corepack pnpm --filter @solara/studio dev",
    "doctor:export": "vitest run scripts/export-doctor.test.ts --exclude \"back up/**\" --exclude \".local-backups/**\"",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "playwright:install:chromium": "playwright install chromium",
    "playwright:install:release": "playwright install chromium firefox webkit",
    "pilot:preflight": "vitest run scripts/pilot-preflight.test.ts --exclude \"back up/**\" --exclude \".local-backups/**\"",
    "pilot:export": "vitest run scripts/write-pilot-export.test.ts --exclude \"back up/**\" --exclude \".local-backups/**\"",
    "qa:factory": "node --experimental-transform-types --experimental-loader ./scripts/ts-workspace-loader.mjs scripts/store-factory.mjs",
    "reference:export": "vitest run scripts/write-reference-export.test.ts",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "test:e2e:release": "node scripts/release-e2e.mjs",
    "vitest": "node scripts/vitest-limited.mjs",
    "test": "corepack pnpm -r --workspace-concurrency=1 --if-present test -- --testTimeout=15000",
    "test:fuzz": "corepack pnpm --filter @solara/core test:fuzz && corepack pnpm --filter @solara/studio test:fuzz",
    "test:stress": "corepack pnpm --filter @solara/exporter test:stress && corepack pnpm --filter @solara/site-optimizer test:stress",
    "test:qa": "corepack pnpm --filter @solara/agent-control test:qa",
    "test:codex-subagent-smoke": "node scripts/vitest-limited.mjs run scripts/codex-subagent-smoke.test.ts --exclude \"back up/**\" --exclude \".local-backups/**\"",
    "test:diagnostic": "corepack pnpm --filter @solara/project-schema test:diagnostic",
    "test:postbuild": "corepack pnpm --filter @solara/project-schema test:postbuild",
    "test:extended": "corepack pnpm test:mutation && corepack pnpm test:fuzz && corepack pnpm test:qa",
    "test:e2e": "node scripts/e2e-smoke.mjs --full && node scripts/e2e-run.mjs functional",
    "test:e2e:audit": "node scripts/e2e-smoke.mjs --full && node scripts/e2e-run.mjs audit",
    "test:e2e:smoke": "node scripts/e2e-smoke.mjs",
    "test:e2e:smoke:quick": "node scripts/e2e-smoke.mjs --quick",
    "test:e2e:smoke:full": "node scripts/e2e-smoke.mjs --smoke-full",
    "test:e2e:ci": "node scripts/e2e-run.mjs functional tests/e2e/exported-store.spec.ts tests/e2e/storefront-nojs.spec.ts tests/e2e/interacciones.spec.ts tests/e2e/focus-visible.spec.ts tests/e2e/exporter-sentinel.spec.ts --workers=2 --retries=0",
    "typecheck": "corepack pnpm -r --workspace-concurrency=2 --if-present typecheck",
    "build:all": "corepack pnpm -r --if-present build",
    "test:affected": "node scripts/test-affected.mjs",
    "typecheck:affected": "node scripts/typecheck-affected.mjs",
    "check:micro": "git diff --check && corepack pnpm check:responsive && corepack pnpm check:repository && node scripts/typecheck-affected.mjs && node scripts/test-affected.mjs",
    "check:fast": "node scripts/check-quick.mjs",
    "check:slow": "corepack pnpm check:optimization && corepack pnpm check:runtime-serialization && corepack pnpm check:budgets",
    "release": "corepack pnpm check:full && node scripts/release-e2e.mjs --skip-build",
    "test:audit": "node scripts/test-suite-audit.mjs --strict",
    "test:mutation": "node scripts/mutation-smoke.mjs",
    "test:quality": "corepack pnpm test:audit && corepack pnpm test:mutation",
    "test:tiny": "node scripts/test-affected.mjs",
    "test:normal": "corepack pnpm -r --workspace-concurrency=1 --if-present test -- --testTimeout=15000",
    "test:full": "corepack pnpm test:normal && corepack pnpm test:contracts && corepack pnpm test:extended",
    "test:contracts": "node scripts/vitest-limited.mjs run scripts/codex-collaboration.test.ts scripts/contratos-profundos.test.ts scripts/contratos.test.ts scripts/enganches.test.ts scripts/parity-sweep.test.ts scripts/seo-check.test.ts scripts/sitio-consistencia.test.ts scripts/test-affected-map.test.ts scripts/test-impact.test.ts scripts/test-runner-guard.test.ts --exclude \"back up/**\" --exclude \".local-backups/**\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.2.2",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
